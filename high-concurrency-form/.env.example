# Cổng chạy ứng dụng Backend
PORT=5000

# Cấu hình Redis (dùng cho BullMQ Queue)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Cấu hình PostgreSQL Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_NAME=high_concurrency_db

# Kích thước Connection Pool tối đa cho Database
DB_POOL_MAX=25
DB_IDLE_TIMEOUT=30000
